@ARTICLE{Yoder2011-jh,
  title    = "Both visual and idiothetic cues contribute to head direction cell
              stability during navigation along complex routes",
  author   = "Yoder, Ryan M and Clark, Benjamin J and Brown, Joel E and Lamia,
