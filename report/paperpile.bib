  author   = "Parak, W J and Hofmann, U G and Gaub, H E and Owicki, J C",
  journal  = "Sens. Actuators A Phys.",
  volume   =  63,
  pages    = "47--57",
  abstract = "The surface potential of semiconductor devices in contact with
