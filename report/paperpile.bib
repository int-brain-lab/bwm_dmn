@ARTICLE{Hevner1992-jy,
  title    = "Entorhinal cortex of the human, monkey, and rat: metabolic map as
              revealed by cytochrome oxidase",
  author   = "Hevner, R F and Wong-Riley, M T",
  journal  = "J. Comp. Neurol.",
  address  = "Department of Cellular Biology and Anatomy, Medical College of
