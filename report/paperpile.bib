  month    =  oct,
  year     =  1995
}

@ARTICLE{Zhu2000-nu,
  title    = "Postnatal synaptic potentiation: delivery of {GluR4}-containing
              {AMPA} receptors by spontaneous activity",
  author   = "Zhu, J J and Esteban, J A and Hayashi, Y and Malinow, R",
