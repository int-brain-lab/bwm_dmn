  year     =  2002
}

@ARTICLE{Patla2002-ys,
  title    = "Understanding the contribution of binocular vision to the control
              of adaptive locomotion",
  author   = "Patla, Aftab E and Niechwiej, Ewa and Racco, Vincent and Goodale,
