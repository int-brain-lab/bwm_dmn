              activating the inhibitory network phase locks the firing of
              otherwise unconnected pairs of projection neurons, suggesting that
              local inhibition could coordinate RA output during singing.",
  month    =  jun,
  year     =  1999
}

@ARTICLE{Treue2000-xx,
  title    = "Seeing multiple directions of motion-physiology and psychophysics",
  author   = "Treue, S and Hol, K and Rauber, Hj",
  journal  = "Nat. Neurosci.",
  volume   =  3,
  number   =  3,
  pages    = "270--276",
  abstract = "Dot patterns sliding transparently across one another are normally
