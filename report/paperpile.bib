  journal  = "Proc. Natl. Acad. Sci. U. S. A.",
  volume   =  118,
  number   =  50,
  abstract = "Adaptive memory recall requires a rapid and flexible switch from
              external perceptual reminders to internal mnemonic
              representations. However, owing to the limited temporal or spatial
              resolution of brain imaging modalities used in isolation, the
              hippocampal-cortical dynamics supporting this process remain
