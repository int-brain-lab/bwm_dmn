              Nonlinear Dynamics; Orientation/physiology; Parietal
              Lobe/*cytology; Photic Stimulation/methods; Psychometrics/methods;
              Reaction Time/physiology; Time Factors",
  language = "eng"
}

@ARTICLE{Koulakov2002-qo,
