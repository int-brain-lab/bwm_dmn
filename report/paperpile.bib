@ARTICLE{Hirsch1998-dg,
  title    = "Synaptic integration in striate cortical simple cells",
  author   = "Hirsch, Ja and Alonso, Jm and Reid, Rc and Martinez, Lm",
  journal  = "J. Neurosci.",
  volume   =  18,
  number   =  22,
  pages    = "9517--9528",
  abstract = "Simple cells in the visual cortex respond to the precise position
