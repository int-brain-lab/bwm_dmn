  year     =  2006,
  language = "eng"
}

@ARTICLE{Softky1993-vy,
  title    = "The highly irregular firing of cortical cells is inconsistent with
              temporal integration of random {EPSPs}",
  author   = "Softky, W R and Koch, C",
  journal  = "J. Neurosci.",
  address  = "Division of Physics, Mathematics, and Astronomy, California
