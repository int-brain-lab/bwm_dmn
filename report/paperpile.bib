@ARTICLE{Graves2001-md,
  title    = "Sleep and memory: a molecular perspective",
  author   = "Graves, L and Pack, A and Abel, T",
  journal  = "Trends Neurosci.",
  volume   =  24,
  number   =  4,
  pages    = "237--243",
  abstract = "This review synthesizes data from behavioral studies examining the
              role of sleep in memory storage with what is known about the
              molecular mechanisms of memory consolidation. There are striking
              similarities in the effects on memory storage of post-training
              pharmacological manipulations and post-training manipulations of
              sleep. For example, inhibition of protein synthesis is most
              effective if it occurs at a time post-training when rapid eye
