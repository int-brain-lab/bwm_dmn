  author   = "Schweighofer, N and Arbib, M A and Kawato, M",
  journal  = "Eur. J. Neurosci.",
  volume   =  10,
  number   =  1,
  pages    = "86--94",
  abstract = "This study focuses on the role of the motor cortex, the spinal
