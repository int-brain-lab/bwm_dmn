  month       =  apr,
  year        =  2001
}

@ARTICLE{Feng2001-yv,
  title    = "On the stability analysis of delayed neural networks systems",
  author   = "Feng, Chunhua and Plamondon, Réjean",
  journal  = "Neural Netw.",
  volume   =  14,
  number   =  9,
  pages    = "1181--1188",
  abstract = "In this paper, the problems of stability of delayed neural
              networks are investigated, including the stability of discrete and
              distributed delayed neural networks. Under the generalization of
              dropping the Lipschitzian hypotheses for output functions, some
              stability criteria are obtained by using the Liapunov functional
              method. We do not assume the symmetry of the connection matrix and
