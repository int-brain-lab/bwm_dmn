@ARTICLE{Callaway1998-ol,
  title    = "Local circuits in primary visual cortex of the macaque monkey",
  author   = "Callaway, Em",
  journal  = "Annu. Rev. Neurosci.",
  volume   =  21,
  pages    = "47--74",
  abstract = "The basic laminar organization of excitatory local circuitry in
              the primary visual cortex of the macaque monkey is similar to that
              described previously in the cat's visual cortex (Gilbert 1983).
              This circuitry is described here in the context of a two-level
              model that distinguishes between feedforward and feedback
