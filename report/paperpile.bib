  year     =  1998
}

@ARTICLE{Hirsch2002-xg,
  title    = "Synaptic physiology of the flow of information in the cat's visual
              cortex in vivo",
  author   = "Hirsch, Ja and Martinez, Lm and Alonso, Jm and Desai, K and
              Pillai, C and Pierre, C",
  journal  = "J. Physiol.",
  volume   =  540,
  number   = "Pt 1",
  pages    = "335--350",
  abstract = "Each stage of the striate cortical circuit extracts novel
              information about the visual environment. We asked if this
              analytic process reflected laminar variations in synaptic
              physiology by making whole-cell recording with dye-filled
              electrodes from the cat's visual cortex and thalamus; the stimuli
