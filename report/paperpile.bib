@ARTICLE{Carandini1997-fg,
  title    = "A tonic hyperpolarization underlying contrast adaptation in cat
              visual cortex",
  author   = "Carandini, M and Ferster, D",
  journal  = "Science",
  volume   =  276,
  number   =  5314,
  pages    = "949--952",
  abstract = "The firing rate responses of neurons in the primary visual cortex
              grow with stimulus contrast, the variation in the luminance of an
              image relative to the mean luminance. These responses, however,
              are reduced after a cell is exposed for prolonged periods to
              high-contrast visual stimuli. This phenomenon, known as contrast
