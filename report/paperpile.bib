@ARTICLE{Dantzker2000-fy,
  title    = "Laminar sources of synaptic input to cortical inhibitory
              interneurons and pyramidal neurons",
  author   = "Dantzker, Jl and Callaway, Em",
  journal  = "Nat. Neurosci.",
  volume   =  3,
  number   =  7,
  pages    = "701--707",
  abstract = "The functional role of an individual neuron within a cortical
              circuit is largely determined by that neuron's synaptic input. We
              examined the laminar sources of local input to subtypes of
              cortical neurons in layer 2/3 of rat visual cortex using laser
