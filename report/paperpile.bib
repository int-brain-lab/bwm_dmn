@ARTICLE{Fuchs1988-jy,
  title    = "Discharge patterns and recruitment order of identified motoneurons
              and internuclear neurons in the monkey abducens nucleus",
  author   = "Fuchs, A F and Scudder, C A and Kaneko, C R",
