@ARTICLE{Koyluoglu2017-il,
  title    = "Fundamental bound on the persistence and capacity of short-term
              memory stored as graded persistent activity",
  author   = "Koyluoglu, Onur Ozan and Pertzov, Yoni and Manohar, Sanjay and
