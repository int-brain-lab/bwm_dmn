@ARTICLE{Todorov2000-le,
  title    = "Direct cortical control of muscle activation in voluntary arm
              movements: a model",
  author   = "Todorov, E",
  journal  = "Nat. Neurosci.",
  volume   =  3,
  number   =  4,
  pages    = "391--398",
  abstract = "What neural activity in motor cortex represents and how it
