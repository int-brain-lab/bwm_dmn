}

@ARTICLE{Bottjer1984-bk,
  title    = "Forebrain lesions disrupt development but not maintenance of song
              in passerine birds",
  author   = "Bottjer, S W and Miesner, E A and Arnold, A P",
  journal  = "Science",
  volume   =  224,
  number   =  4651,
  pages    = "901--3.",
  abstract = "The magnocellular nucleus of the anterior neostriatum is a
              forebrain nucleus of passerine birds that accumulates testosterone
              and makes monosynaptic connections with other telencephalic nuclei
              that control song production in adult birds. Lesions in the
              magnocellular nucleus disrupted song development in juvenile male
              zebra finches but did not affect maintenance of stable song
              patterns by adult birds. These results represent an instance in
              which lesions of a discrete brain region during only a restricted
              phase in the development of a learned behavior cause permanent
              impairment. Because cells of the magnocellular nucleus accumulate
              androgens these findings raise the possibility that this learning
              is mediated by hormones.",
