@ARTICLE{Burwell2003-yq,
  title    = "Positional firing properties of postrhinal cortex neurons",
  author   = "Burwell, R D and Hafeman, D M",
  journal  = "Neuroscience",
  volume   =  119,
  number   =  2,
  pages    = "577--588",
  abstract = "Hippocampal cell firing in awake, behaving rats is often spatially
              selective, and such cells have been called place cells. Similar
              spatial correlates have also been described for neurons in the
              medial entorhinal and perirhinal cortices. All three regions
              receive sensory associational input from postrhinal cortex, which,
