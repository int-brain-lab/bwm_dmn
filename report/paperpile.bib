@ARTICLE{Katz1996-mq,
  title    = "Synaptic activity and the construction of cortical circuits",
  author   = "Katz, L C and Shatz, C J",
  journal  = "Science",
  volume   =  274,
  number   =  5290,
  pages    = "1133--1138",
  abstract = "Vision is critical for the functional and structural maturation of
              connections in the mammalian visual system. Visual experience,
              however, is a subset of a more general requirement for neural
              activity in transforming immature circuits into the organized
              connections that subserve adult brain function. Early in
              development, internally generated spontaneous activity sculpts
              circuits on the basis of the brain's ``best guess'' at the initial
              configuration of connections necessary for function and survival.
