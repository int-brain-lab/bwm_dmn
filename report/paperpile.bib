@ARTICLE{Grah2005-gl,
  title    = "Path integration in a three-dimensional maze: ground distance
              estimation keeps desert ants Cataglyphis fortis on course",
  author   = "Grah, Gunnar and Wehner, Rudiger and Ronacher, Bernhard",
