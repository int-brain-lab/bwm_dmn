  author   = "Chen, Ying and Byrne, Patrick and Crawford, J Douglas",
  journal  = "Neuropsychologia",
  volume   =  49,
  number   =  1,
  pages    = "49--60",
  abstract = "Allocentric cues can be used to encode locations in visuospatial
