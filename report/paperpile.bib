@ARTICLE{Ivanchenko2003-ka,
  title    = "A developmental approach {AIDS} motor learning",
  author   = "Ivanchenko, V and Jacobs, Ra",
  journal  = "Neural Comput.",
  volume   =  15,
  number   =  9,
  pages    = "2051--65.",
  abstract = "Bernstein (1967) suggested that people attempting to learn to
