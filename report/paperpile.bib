@ARTICLE{Reich2001-mw,
  title    = "Independent and redundant information in nearby cortical neurons",
  author   = "Reich, Ds and Mechler, F and Victor, Jd",
  journal  = "Science",
  volume   =  294,
  number   =  5551,
  pages    = "2566--2568",
  abstract = "In the primary visual cortex (V1), nearby neurons are tuned to
              similar stimulus features, and, depending on the manner and time
              scale over which neuronal signals are analyzed, the resulting
              redundancy may mitigate deleterious effects of response
              variability. We estimated information rates in the short-time
              scale responses of clusters of up to six simultaneously recorded
              nearby neurons in monkey V1. Responses were almost independent if
              we kept track of which neuron fired each spike but were redundant
              if we summed responses over the cluster. Redundancy was
