@ARTICLE{Yang2016-du,
  title    = "A dendritic disinhibitory circuit mechanism for pathway-specific
              gating",
  author   = "Yang, Guangyu Robert and Murray, John D and Wang, Xiao-Jing",
  journal  = "Nat. Commun.",
  volume   =  7,
  pages    =  12815,
  abstract = "While reading a book in a noisy café, how does your brain 'gate
              in' visual information while filtering out auditory stimuli? Here
              we propose a mechanism for such flexible routing of information
              flow in a complex brain network (pathway-specific gating), tested
              using a network model of pyramidal neurons and three classes of
              interneurons with connection probabilities constrained by data. We
              find that if inputs from different pathways cluster on a pyramidal
              neuron dendrite, a pathway can be gated-on by a disinhibitory
