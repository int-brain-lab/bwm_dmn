  language = "en"
}

@ARTICLE{Chandra2024-iq,
  title    = "Self-organized emergence of modularity, hierarchy, and mirror
              reversals from competitive synaptic growth in a developmental
              model of the visual pathway",
  author   = "Chandra, Sarthak and Khona, Mikail and Konkle, Talia and Fiete, I",
  journal  = "bioRxiv",
  abstract = "A hallmark of the primate visual system is its architectural
              organization consisting of multiple distinct (modular) areas that
              connect hierarchically. These areas exhibit specific spatial
              organization on the cortical sheet, with primary visual cortex at
              the center and subsequent regions in the hierarchy encircling the
