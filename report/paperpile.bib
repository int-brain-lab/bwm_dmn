@ARTICLE{Stockl2021-ri,
  title    = "Probabilistic skeletons endow brain-like neural networks with
              innate computing capabilities",
  author   = "Stöckl, Christoph and Lang, Dominik and Maass, Wolfgang",
  journal  = "bioRxiv",
  pages    = "2021.05.18.444689",
  abstract = "Genetically encoded structure endows neural networks of the brain
              with innate computational capabilities that enable odor
              classification and basic motor control right after birth. It is
              also conjectured that the stereotypical laminar organization of
              neocortical microcircuits provides basic computing capabilities on
              which subsequent learning can build. However, it has re-mained
