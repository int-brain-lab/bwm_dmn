  month    =  apr,
  year     =  1995
}

@ARTICLE{Somers1995-qz,
  title    = "An emergent model of orientation selectivity in cat visual
              cortical simple cells",
  author   = "Somers, Dc and Nelson, Sb and Sur, M",
  journal  = "J. Neurosci.",
  volume   =  15,
  number   =  8,
  pages    = "5448--5465",
  abstract = "It is well known that visual cortical neurons respond vigorously
              to a limited range of stimulus orientations, while their primary
              afferent inputs, neurons in the lateral geniculate nucleus (LGN),
              respond well to all orientations. Mechanisms based on
              intracortical inhibition and/or converging thalamocortical
