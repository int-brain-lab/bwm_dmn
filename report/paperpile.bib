@ARTICLE{Cullen1996-vx,
  title    = "The use of system identification techniques in the analysis of
              oculomotor burst neuron spike train dynamics",
  author   = "Cullen, K E and Rey, C G and Guitton, D and Galiana, H L",
  journal  = "J. Comput. Neurosci.",
