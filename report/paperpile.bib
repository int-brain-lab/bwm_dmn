  month    =  apr,
  year     =  2002
}

@ARTICLE{Martinez2001-yy,
  title    = "Construction of complex receptive fields in cat primary visual
              cortex",
  author   = "Martinez, Lm and Alonso, Jm",
  journal  = "Neuron",
  volume   =  32,
  number   =  3,
  pages    = "515--525",
  abstract = "In primary visual cortex, neurons are classified into simple cells
              and complex cells based on their response properties. Although the
              role of these two cell types in vision is still unknown, an
              attractive hypothesis is that simple cells are necessary to
              construct complex receptive fields. This hierarchical model puts
