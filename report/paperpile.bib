  author   = "Yuste, R and Nelson, D A and Rubin, W W and Katz, L C",
  journal  = "Neuron",
  volume   =  14,
  number   =  1,
  pages    = "7--17",
  abstract = "The mammalian neocortex consists of columnar circuits, whose
