@ARTICLE{Gorchetchnikov2007-tc,
  title    = "Space, time and learning in the hippocampus: how fine spatial and
              temporal scales are expanded into population codes for behavioral
              control",
  author   = "Gorchetchnikov, Anatoli and Grossberg, Stephen",
