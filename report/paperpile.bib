@ARTICLE{Barto1985-pt,
  title    = "Pattern-Recognizing Stochastic Learning Automata",
  author   = "Barto, A G and Anandan, P",
  journal  = "IEEE Trans. Syst. Man Cybern.",
  volume   =  15,
  number   =  3,
  pages    = "360--375",
  abstract = "A class of learning tasks is described that combines aspects of
