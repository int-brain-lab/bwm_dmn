@ARTICLE{Schiltz2010-lb,
  title    = "Holistic perception of individual faces in the right middle
              fusiform gyrus as evidenced by the composite face illusion",
  author   = "Schiltz, Christine and Dricot, Laurence and Goebel, Rainer and
