@ARTICLE{Jordan1992-cv,
  title    = "Forward Models: Supervised Learning with a Distal Teacher",
  author   = "Jordan, Michael I and Rumelhart, David E",
  journal  = "Cogn. Sci.",
  volume   =  16,
  pages    = "307--354",
  abstract = "Internal models of the environment have an important role to play
              in adaptive systems in general and are of particular importance
              for the supervised learning paradigm. In this paper we demonstrate
              that certain classical problems associated with the notion of the
              ``teacher'' in supervised learning can be solved by judicious use
              of learned internal models as components of the adaptive system.
