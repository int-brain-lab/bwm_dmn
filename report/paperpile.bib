@ARTICLE{Dobrunz1997-ic,
  title    = "Heterogeneity of release probability, facilitation, and depletion
              at central synapses",
  author   = "Dobrunz, L E and Stevens, C F",
  journal  = "Neuron",
  volume   =  18,
  number   =  6,
  pages    = "995--1008",
  abstract = "Previous studies of short-term plasticity in central nervous
