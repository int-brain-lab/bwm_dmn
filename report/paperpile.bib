  year     =  1989
}

@ARTICLE{Jung1993-ps,
  title    = "Spatial selectivity of unit activity in the hippocampal granular
              layer",
  author   = "Jung, M W and McNaughton, B L",
  journal  = "Hippocampus",
  volume   =  3,
  number   =  2,
  pages    = "165--82.",
  abstract = "Single neuron activity was recorded in the granular layer of the
              fascia dentata in freely moving rats, while the animals performed
              a spatial ``working'' memory task on an eight-arm maze. Using
              recording methods that facilitate detection of units with low
              discharge rates, it was found that the majority (88\%) of cells in
