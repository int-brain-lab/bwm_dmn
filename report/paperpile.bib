@ARTICLE{Markus1995-lu,
  title    = "Interactions between location and task affect the spatial and
              directional firing of hippocampal neurons",
  author   = "Markus, E J and Qin, Y L and Leonard, B and Skaggs, W E and
              McNaughton, B L and Barnes, C A",
  journal  = "J. Neurosci.",
  address  = "ARL Division of Neural Systems, University of Arizona, Tucson
